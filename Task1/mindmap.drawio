<mxfile host="app.diagrams.net">
  <diagram name="Data Security Mindmap">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Core -->
        <mxCell id="core" value="Безопасность данных" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="500" y="300" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- PUBLIC -->
        <mxCell id="cat_public" value="Публичные данные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="150" y="100" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="public_data" value="Маркетинговые материалы&#xa;Описание продуктов&#xa;Публичная документация API" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="180" width="200" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="public_risk" value="Риск: Low" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="20" y="310" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="public_reason" value="Данные предназначены для публичного распространения. Утечка не наносит прямого ущерба." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="390" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- INTERNAL -->
        <mxCell id="cat_internal" value="Внутренние данные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="150" y="450" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="internal_data" value="Внутренние документы&#xa;Бизнес-процессы&#xa;Техническая документация" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="540" width="200" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="internal_risk" value="Риск: Medium" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="20" y="660" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="internal_reason" value="Раскрытие может привести к утечке бизнес-логики и конкурентным преимуществам." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="740" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- PERSONAL -->
        <mxCell id="cat_personal" value="Персональные данные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="personal_data" value="ФИО клиентов&#xa;Email&#xa;Телефоны&#xa;Адреса" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="180" width="200" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="personal_risk" value="Риск: High" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="980" y="300" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="personal_reason" value="Утечка персональных данных нарушает GDPR и может привести к штрафам и репутационному ущербу." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="380" width="230" height="100" as="geometry"/>
        </mxCell>

        <!-- FINANCIAL -->
        <mxCell id="cat_financial" value="Финансовые данные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="820" y="450" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="financial_data" value="Платежные операции&#xa;Банковские реквизиты&#xa;История транзакций" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="540" width="200" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="financial_risk" value="Риск: Critical" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="980" y="660" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="financial_reason" value="Компрометация финансовых данных ведет к прямым финансовым потерям и юридической ответственности." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="740" width="230" height="100" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>